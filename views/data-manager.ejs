<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 数据管理</title>
    <meta name="description" content="数据导入导出管理，支持JSON和Excel格式">
    <meta name="keywords" content="数据管理,导入导出,JSON,Excel">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/data-manager.css">
    
    <!-- Vue 3 CDN -->
    <script src="/js/vue.global.js"></script>
    <!-- Axios CDN -->
    <script src="/js/axios.min.js"></script>

    <!-- 注入服务端默认数据，使“恢复默认”和默认测试在本页可用 -->
    <script>
      window.__DEFAULT_DATA__ = <%- JSON.stringify(defaultData || {}) %>;
      window.__FEEDBACK_URL__ = '<%= typeof feedbackUrl !== 'undefined' ? feedbackUrl : 'https://admin.ycz.me/api/site.index/feedback' %>';
    </script>
<!-- Google Tag Manager -->
	<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
	new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
	j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
	'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
	})(window,document,'script','dataLayer','GTM-556X699R');</script>
<!-- End Google Tag Manager -->
</head>
<body>
		<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-556X699R"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <div id="app">
        <!-- 顶部导航栏 -->
        <div class="top-bar">
            <div class="top-nav-links">
                <a href="/" class="nav-link">返回首页</a>
                <a href="/ai-chat" class="nav-link">AI聊天</a>
                <a href="/emoji" class="nav-link">Emoji图标</a>
                <span class="nav-link active">数据管理</span>
            </div>
        </div>

        <!-- 主内容区域 -->
        <main class="data-manager-main">
            <div class="data-manager-container">

                <!-- 页面头部 -->
                <div class="page-header">
                    <h1>
                        <i class="fas fa-database"></i>
                        数据管理中心
                    </h1>
                </div>

                <!-- 主内容区域 -->
                <div class="main-content" id="app" style="margin-left:0;">
                    <!-- 状态消息 -->
                    <div v-if="statusMessage" 
                         class="status-message" 
                         :class="statusMessage.type">
                        <i class="status-icon" :class="getStatusIcon(statusMessage.type)"></i>
                        <span class="status-text">{{ statusMessage.text }}</span>
                    </div>

                    <!-- 后台接口管理 -->
                    <div class="action-section">
                        <div class="import-section">
                            <div class="section-header">
                                <h3><i class="fas fa-link"></i> 后台接口管理</h3>
                                <p class="section-desc">设置用于首访初始化与“恢复默认”的数据接口地址</p>
                            </div>
                            <div class="file-info" style="display:block;">
                                <div class="file-meta" style="width:100%;">
                                    <label for="apiUrlInput">自定义默认API地址</label>
                                    <input id="apiUrlInput" type="text" v-model="apiUrlInput" placeholder="例如：https://your.domain/api/nav.index/default" style="width:100%;padding:10px;margin-top:6px;">
                                    <div class="file-actions" style="margin-top:10px;display:flex;gap:10px;">
                                        <button class="btn btn-primary" @click="saveApiUrl">
                                            <i class="fas fa-save"></i>
                                            保存接口地址
                                        </button>
                                        <button class="btn btn-outline" @click="clearApiUrl">
                                            <i class="fas fa-eraser"></i>
                                            清除自定义
                                        </button>
                                        <button class="btn btn-secondary" @click="testFetchDefaultApi">
                                            <i class="fas fa-vial"></i>
                                            测试拉取数据
                                        </button>
                                    </div>
                                    <div class="drop-subtext" style="margin-top:8px;">
                                        当前生效：{{ effectiveApiLabel }}
                                    </div>
                                    <details style="margin-top:10px;">
                                        <summary>接口返回格式要求（点击展开）</summary>
                                        <div style="margin-top:8px;font-size:13px;color:#666;line-height:1.6;">
                                            <p>后端需返回 JSON，键名需与本站一致：</p>
                                            <pre style="white-space:pre-wrap;background:#f8f8f8;padding:10px;border-radius:6px;">{
  "categories": [ { "id": "string", "name": "string", "icon": "string" } ],
  "websites":   [ { "id": "string", "name": "string", "url": "string", "categoryId": "string" } ],
  "filters":    [ { "id": "string", "name": "string", "rule": "string" } ],
  "searchEngines": [ { "id": "string", "name": "string", "queryUrl": "string" } ]
}</pre>
                                            <p>说明：无需前端适配，请确保字段与结构严格匹配。</p>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                   

                    <!-- 同步到后台 -->
                    
                        <div class="import-section">
                            <div class="section-header">
                                <h3><i class="fas fa-sync-alt"></i> 同步到后台</h3>
                                <p class="section-desc">设置同步接口，将本地数据以JSON上传，或上传Excel到后端</p>
                            </div>
                            <div class="file-info" style="display:block;">
                                <div class="file-meta" style="width:100%;">
                                    <label for="syncApiUrlInput">同步API地址</label>
                                    <input id="syncApiUrlInput" type="text" v-model="syncApiUrlInput" placeholder="例如：https://your.domain/api/nav.sync/upload" style="width:100%;padding:10px;margin-top:6px;">
                                    <div class="file-actions" style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap;">
                                        <button class="btn btn-primary" @click="saveSyncApiUrl">
                                            <i class="fas fa-save"></i>
                                            保存同步地址
                                        </button>
                                        <button class="btn btn-outline" @click="clearSyncApiUrl">
                                            <i class="fas fa-eraser"></i>
                                            清除同步地址
                                        </button>
                                        <button class="btn btn-secondary" @click="syncToBackendJson">
                                            <i class="fas fa-upload"></i>
                                            同步当前数据(JSON)
                                        </button>
                                        <button class="btn btn-outline" @click="$refs.syncExcelInput.click()">
                                            <i class="fas fa-file-upload"></i>
                                            选择Excel上传
                                        </button>
                                        <input type="file" ref="syncExcelInput" accept=".xlsx,.xls" style="display:none" @change="syncHandleExcelSelect">
                                        <button class="btn btn-secondary" @click="syncUploadExcelToBackend" :disabled="!syncSelectedExcel">
                                            <i class="fas fa-paper-plane"></i>
                                            上传选中Excel
                                        </button>
                                    </div>
                                    <div class="drop-subtext" style="margin-top:8px;">
                                        同步地址：{{ effectiveSyncLabel }}
                                        <span v-if="syncSelectedExcel">｜已选文件：{{ syncSelectedExcel.name }}</span>
                                    </div>
                                    <details style="margin-top:10px;">
                                        <summary>同步接口要求（点击展开）</summary>
                                        <div style="margin-top:8px;font-size:13px;color:#666;line-height:1.6;">
                                            <p>JSON 同步：前端会以 <code>application/json</code> POST 以下结构到同步接口：</p>
                                            <pre style="white-space:pre-wrap;background:#f8f8f8;padding:10px;border-radius:6px;">{
  "categories": [...],
  "websites": [...],
  "filters": [...],
  "searchEngines": [...],
  "timestamp": 1710000000000
}</pre>
                                            <p>Excel 上传：以 <code>multipart/form-data</code> 上传，字段名为 <code>file</code>。后端可自行解析，推荐映射为与 JSON 一致的字段。</p>
                                            <p>说明：无需前端适配，请确保后端按本站格式处理与返回。</p>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 导入导出操作区 -->
                    <div class="action-section">
                        <!-- 导入区域 -->
                        <div class="import-section">
                            <div class="section-header">
                                <h3><i class="fas fa-upload"></i> 导入数据</h3>
                                <p class="section-desc">支持导入JSON和Excel格式的网站和分类数据</p>
                            </div>
                            
                            <div class="file-drop-zone" 
                                 @drop="handleFileDrop" 
                                 @dragover.prevent 
                                 @dragenter.prevent
                                 :class="{ 'drag-over': isDragOver }"
                                 @dragenter="isDragOver = true"
                                 @dragleave="isDragOver = false">
                                <input type="file" 
                                       ref="fileInput"
                                       id="fileInput" 
                                       accept=".json,.xlsx,.xls" 
                                       @change="handleFileSelect" 
                                       style="display: none;">
                                <div class="upload-content">
                                    <i class="upload-icon fas fa-cloud-upload-alt"></i>
                                    <div class="drop-text">拖拽JSON或Excel文件到此处</div>
                                    <div class="drop-subtext">或者</div>
                                    <button type="button" class="btn btn-outline" @click="$refs.fileInput.click()">
                                        <i class="fas fa-folder-open"></i>
                                        选择文件
                                    </button>
                                </div>
                            </div>
                            
                            <div v-if="selectedFile" class="file-info">
                                <div class="file-details">
                                    <div class="file-icon">
                                        <i class="fas fa-file-code"></i>
                                    </div>
                                    <div class="file-meta">
                                        <div class="file-name">{{ selectedFile.name }}</div>
                                        <div class="file-size">{{ formatFileSize(selectedFile.size) }}</div>
                                    </div>
                                </div>
                                <div class="file-actions">
                                    <button class="btn btn-primary" @click="importData">
                                        <i class="fas fa-download"></i>
                                        导入数据
                                    </button>
                                    <button class="btn btn-outline" @click="clearFile">
                                        <i class="fas fa-times"></i>
                                        清除
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 导出区域 -->
                        <div class="export-section">
                            <div class="section-header">
                                <h3><i class="fas fa-download"></i> 导出数据</h3>
                                <p class="section-desc">将当前数据导出为JSON格式文件</p>
                            </div>
                            
                            <div class="export-stats">
                                <div class="stat-item">
                                    <div class="stat-icon">
                                        🌐
                                    </div>
                                    <div class="stat-content">
                                        <div class="stat-value">{{ websiteCount }}</div>
                                        <div class="stat-label">网站数量</div>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon">
                                        📁
                                    </div>
                                    <div class="stat-content">
                                        <div class="stat-value">{{ categoryCount }}</div>
                                        <div class="stat-label">分类数量</div>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon">🏷️</div>
                                    <div class="stat-content">
                                        <div class="stat-value">{{ filterCount }}</div>
                                        <div class="stat-label">筛选标签</div>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon">🔎</div>
                                    <div class="stat-content">
                                        <div class="stat-value">{{ engineCount }}</div>
                                        <div class="stat-label">搜索引擎</div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="export-buttons">
                                <button @click="exportAsJSON" class="export-btn json-btn">
                                    <i class="fas fa-download"></i>
                                    导出为 JSON
                                </button>
                                <button @click="exportExcel" class="export-btn excel-btn">
                                    <i class="fas fa-file-excel"></i>
                                    导出为 Excel
                                </button>
                            </div>
                        </div>

                        <!-- 恢复默认数据 -->
                        <div class="export-section">
                            <div class="section-header">
                                <h3><i class="fas fa-undo"></i> 恢复默认数据</h3>
                                <p class="section-desc">清空本地数据并写入系统默认数据（建议先备份）</p>
                            </div>

                            <div class="export-buttons">
                                <button @click="exportAsJSON" class="export-btn json-btn">
                                    <i class="fas fa-download"></i>
                                    备份当前数据
                                </button>
                                <button @click="restoreDefault" class="export-btn excel-btn" style="background:#ef4444; border-color:#ef4444;">
                                    <i class="fas fa-trash-restore"></i>
                                    恢复默认
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 数据预览区域 -->
                <div v-if="previewData" class="preview-section">
                    <h2>👀 数据预览</h2>
                    <div class="preview-content">
                        <div class="preview-summary">
                            <p>检测到 {{ previewData.websites?.length || 0 }} 个网站，{{ previewData.categories?.length || 0 }} 个分类，{{ previewData.filters?.length || 0 }} 个筛选标签，{{ previewData.searchEngines?.length || 0 }} 个搜索引擎</p>
                        </div>
                        <div class="preview-actions">
                            <button class="btn btn-secondary" @click="cancelImport">取消</button>
                            <button class="btn btn-primary" @click="confirmImport">确认导入</button>
                        </div>
                    </div>
                </div>


            </div>
        </main>
    </div>

    <!-- JavaScript -->
    <script type="module" src="/js/data-manager.js"></script>
    <script type="module" src="/js/data-manager-api-config.js"></script>
    <!-- 首次访问弹窗与公告挂件 -->
    <script type="module" src="/js/first-visit.js"></script>
</body>
</html>