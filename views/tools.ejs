<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="在线工具列表页面">
    <meta name="keywords" content="在线工具,工具列表,网站工具">

    <!-- 复用站点基础样式，使风格与首页一致 -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- 工具页样式 -->
    <link rel="stylesheet" href="/css/tools.css">
</head>
<body>
  <div id="app" class="app-container tools-page" v-cloak>
        <!-- 顶部导航栏（与首页一致的风格） -->
        <main class="main-content">
            <div class="top-bar">
                <div class="top-nav-links">
                    <a href="/" class="nav-link">返回首页</a>
                    <a href="/ai-chat" class="nav-link">AI聊天</a>
                    <span class="nav-link active">在线工具</span>
                </div>
                <div class="top-actions">
                    <div id="dateTrigger" class="date-trigger">
                        <span class="weather-icon" title="天气" @mouseenter="showWeather" @mouseleave="hideWeather">🌤️</span>
                        <span class="nav-link date-text" @mouseenter="showCalendar" @click="toggleCalendar">当前日期：{{ currentDateDisplay }}</span>
                        <div v-if="calendarVisible" class="date-dropdown" @mouseleave.stop="hideCalendar">
                            <div class="calendar-footer">
                                <button class="cal-btn" @click.stop="gotoToday">今天</button>
                            </div>
							
                            <div class="calendar-header">
                                <button class="cal-btn" @click.stop="prevMonth">‹</button>
                                <span class="cal-title" @click.stop="openYmPicker">{{ viewYear }}年{{ viewMonth + 1 }}月</span>
                                <button class="cal-btn" @click.stop="nextMonth">›</button>
                            </div>
                            <div class="ym-picker" v-if="ymPickerVisible" @click.stop>
                                <select id="ymYearSelect" v-model="ymSelectYear">
                                    <option v-for="y in yearOptions" :key="y" :value="y">{{ y }}年</option>
                                </select>
                                <select id="ymMonthSelect" v-model="ymSelectMonth">
                                    <option v-for="m in monthOptions" :key="m" :value="m">{{ m }}月</option>
                                </select>
                                <button id="ymApplyBtn" class="cal-btn" @click.stop="applyYmSelection">确定</button>
                                <button id="ymCancelBtn" class="cal-btn" @click.stop="closeYmPicker">取消</button>
                            </div>
                            <div class="calendar-grid">
                                <div class="cal-weekday" v-for="w in ['日','一','二','三','四','五','六']" :key="w">{{ w }}</div>
                                <div class="cal-day" v-for="d in monthDays" :key="d.key" :class="{ 'out-month': !d.inMonth, 'today': d.isToday, 'selected': d.isSelected }" @click.stop="selectDate(d.date)">
                                    <div class="day-num">{{ d.date.getDate() }}</div>
                                    <div class="day-lunar">{{ d.lunar }}</div>
                                </div>
                            </div>
                            
                            
                        </div>
                        <div v-if="weatherVisible" class="weather-dropdown" @mouseenter="showWeather" @mouseleave="hideWeather">
                            <div class="weather-title">{{ locationName }}</div>
                            <div class="weather-row">天气：暂未接入API</div>
                            <div class="weather-row">温度：-- °C</div>
                            <div class="weather-row">风力：--</div>
                            <div class="weather-tip">可集成天气API显示实时数据</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 工具页主体：上下结构中的下半部分采用左右布局 -->
            <section class="tools-main" aria-label="在线工具">
                <!-- 左：工具列表 -->
                <aside class="tools-sidebar">
                    <div class="tools-title">工具列表</div>
                    <ul class="tools-list">
                        <li v-for="tool in tools" :key="tool.id"
                            :class="['tools-item', { active: currentToolId === tool.id }]"
                            @click="selectTool(tool.id)"
                            :title="tool.name">
                            <span class="tool-icon">{{ tool.icon }}</span>
                            <span class="tool-name">{{ tool.name }}</span>
                        </li>
                    </ul>
                </aside>

                <!-- 右：具体工具内容 -->
                <div class="tools-content">
                    <div class="content-header-row">
                        <h2 class="content-title">{{ currentToolName }}</h2>
                    </div>

                    <!-- 不同工具的占位内容（后续可扩展为具体功能） -->
                    <div v-if="currentToolId === 'timestamp'" class="tool-panel">
                      <div class="tool-form" aria-label="时间戳转换">
                        <div class="tool-row">
                          <label class="tool-label">时间戳</label>
                          <input class="tool-input" type="text" placeholder="输入秒或毫秒级时间戳" v-model="tsInput">
                          <select class="tool-select" v-model="tsUnit">
                            <option value="s">秒</option>
                            <option value="ms">毫秒</option>
                          </select>
                          <button class="tool-btn" @click="tsToDate">转为日期</button>
                        </div>
                        <div class="tool-output" v-if="tsToDateOutput">
                          <span class="output-label">日期：</span>
                          <span class="output-value">{{ tsToDateOutput }}</span>
                        </div>

                        <div class="tool-divider"></div>

                        <div class="tool-row">
                          <label class="tool-label">日期时间</label>
                          <input class="tool-input" type="datetime-local" step="1" v-model="dtInput">
                          <select class="tool-select" v-model="dtOutputUnit">
                            <option value="s">秒</option>
                            <option value="ms">毫秒</option>
                          </select>
                          <button class="tool-btn" @click="dateToTs">转为时间戳</button>
                        </div>
                        <div class="tool-output" v-if="dtToTsOutput">
                          <span class="output-label">时间戳：</span>
                          <span class="output-value">{{ dtToTsOutput }}</span>
                        </div>
                      </div>
                    </div>

                    <div v-else-if="currentToolId === 'base64'" class="tool-panel">
                      <div class="tool-form" aria-label="Base64 编解码">
                        <div class="tool-row column">
                          <label class="tool-label">输入文本</label>
                          <textarea class="tool-textarea" rows="6" placeholder="在此输入需要编解码的文本" v-model="b64Input"></textarea>
                        </div>
                        <div class="tool-actions">
                          <button class="tool-btn primary" @click="b64Encode">编码</button>
                          <button class="tool-btn" @click="b64Decode">解码</button>
                          <button class="tool-btn ghost" @click="clearB64">清空</button>
                        </div>
                        <div class="tool-row column">
                          <label class="tool-label">输出结果</label>
                          <textarea class="tool-textarea" rows="6" readonly v-model="b64Output"></textarea>
                        </div>
                      </div>
                    </div>

                    <div v-else-if="currentToolId === 'url'" class="tool-panel">
                      <div class="tool-form" aria-label="URL 编解码">
                        <div class="tool-row column">
                          <label class="tool-label">输入文本</label>
                          <textarea class="tool-textarea" rows="6" placeholder="在此输入需要URL编解码的文本" v-model="urlInput"></textarea>
                        </div>
                        <div class="tool-actions">
                          <button class="tool-btn primary" @click="urlEncode">编码</button>
                          <button class="tool-btn" @click="urlDecode">解码</button>
                          <button class="tool-btn ghost" @click="clearUrl">清空</button>
                        </div>
                        <div class="tool-row column">
                          <label class="tool-label">输出结果</label>
                          <textarea class="tool-textarea" rows="6" readonly v-model="urlOutput"></textarea>
                        </div>
                      </div>
                    </div>
                    <div v-else class="tool-panel">
                        <p class="placeholder">请选择左侧工具查看具体内容。</p>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Vue 3 -->
    <script src="/js/vue.global.js"></script>
    <!-- 农历工具 -->
    <script src="/js/utils/lunar.js"></script>
    <!-- 工具页应用脚本 -->
    <script src="/js/tools-app.js"></script>
    <!-- 首次访问弹窗与公告挂件 -->
    <script type="module" src="/js/first-visit.js"></script>
</body>
</html>