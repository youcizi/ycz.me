<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="精选优质网站导航，快速找到你需要的网站">
    <meta name="keywords" content="网站导航,导航网站,网址大全,常用网站">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🧭%3C/text%3E%3C/svg%3E">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/category-manager.css">
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
</head>
<body>
    <!-- 整体布局容器 -->
    <div class="app-container">
        <!-- 左侧边栏 -->
        <aside class="sidebar">
            <!-- 收缩/展开按钮 -->
            <button class="sidebar-toggle" type="button" aria-label="收缩/展开侧边栏">
                <span class="toggle-icon">☰</span>
            </button>
            
            <!-- Logo区域 -->
            <div class="sidebar-logo">
                <div class="logo-icon">🧭</div>
                <div>
                    <div class="logo-text">网站导航</div>
                    <div class="logo-subtitle">快速发现优质网站资源</div>
                </div>
            </div>
            
            <!-- 分类导航 -->
            <nav class="sidebar-nav" role="navigation" aria-label="网站分类">
                <% categories.forEach(function(category, index) { %>
                    <button 
                        class="nav-item <%= category.active ? 'active' : '' %>" 
                        data-category="<%= category.name %>"
                        type="button"
                    >
                        <span class="nav-icon"><%= category.icon %></span>
                        <span class="nav-text"><%= category.name %></span>
                        <div class="nav-actions">
                            <span class="action-icon edit-category" onclick="event.stopPropagation(); editCategory('<%= category.name %>');">✏️</span>
                            <span class="action-icon delete-category" onclick="event.stopPropagation(); deleteCategory('<%= category.name %>');">🗑️</span>
                        </div>
                    </button>
                <% }); %>
                <!-- 添加分类按钮 -->
                <button class="nav-item add-category-btn" type="button">
                    <span class="nav-icon">➕</span>
                    <span class="nav-text">添加分类</span>
                </button>
            </nav>
        </aside>

        <!-- 右侧主内容区域 -->
        <main class="main-content">
            <!-- 顶部导航栏 -->
            <div class="top-bar">
                <!-- 左侧导航链接 -->
                <div class="top-nav-links">
                    <a href="#" class="nav-link">关于我们</a>
                    <a href="#" class="nav-link">动态</a>
                    <a href="#" class="nav-link">网址提交</a>
                </div>
                
                <!-- 右侧添加网站按钮 -->
                <div class="top-actions">
                    <button class="add-website-btn" type="button" aria-label="添加网站">
                        <span class="add-icon">➕</span>
                        <span class="add-text">添加网站</span>
                    </button>
                </div>
            </div>
            
            <!-- 搜索栏 -->
            <header class="content-header">
                <div class="search-container">
                    <input 
                        type="text" 
                        id="searchBox" 
                        class="search-box" 
                        placeholder="搜索网站名称或描述..." 
                        autocomplete="off"
                    >
                    <button id="searchBtn" class="search-btn" type="button" aria-label="搜索">
                        🔍
                    </button>
                </div>
            </header>

            <!-- 筛选栏 -->
            <div class="filter-bar">
                <div class="filter-container">
                    <span class="filter-label">筛选：</span>
                    <div class="filter-buttons">
                        <button class="filter-btn active" data-filter="all" type="button">全部</button>
                        <button class="filter-btn" data-filter="free" type="button">免费</button>
                        <button class="filter-btn" data-filter="paid" type="button">付费</button>
                        <button class="filter-btn" data-filter="trial" type="button">试用</button>
                        <button class="filter-btn" data-filter="points" type="button">送积分</button>
                    </div>
                </div>
            </div>

            <!-- 网站展示区域 -->
            <section class="websites-section" aria-label="网站列表">
                <div id="websitesContainer" class="websites-grid">
                    <!-- 网站卡片将通过JavaScript动态加载 -->
                    <% websites.forEach(function(website) { %>
                        <div class="website-card" onclick="window.open('<%= website.url %>', '_blank')">
                    <div class="website-icon"><%= website.icon %></div>
                    <div class="website-info">
                      <h3 class="website-name"><%= website.name %></h3>
                      <p class="website-description"><%= website.description %></p>
                    </div>
                    <div class="card-actions">
                      <div class="action-icon edit-icon" onclick="event.stopPropagation(); handleEditWebsite('<%= website.name %>');">✏️</div>
                      <div class="action-icon delete-icon" onclick="event.stopPropagation(); handleDeleteWebsite('<%= website.name %>');">🗑️</div>
                    </div>
                  </div>
                    <% }); %>
                </div>
            </section>
        </main>
    </div>

    <!-- 添加分类弹窗 -->
    <div id="addCategoryModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>添加分类</h3>
                <span class="close" onclick="hideAddCategoryModal();">&times;</span>
            </div>
            <div class="modal-body">
                <form id="addCategoryForm">
                    <div class="form-group">
                        <label for="categoryName">分类名称：</label>
                        <input type="text" id="categoryName" name="categoryName" required>
                    </div>
                    <div class="form-group">
                        <label for="categoryIcon">分类图标：</label>
                        <div class="icon-input-container">
                            <input type="text" id="categoryIcon" name="categoryIcon" class="icon-input" placeholder="例如：📚" required>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" onclick="hideAddCategoryModal();">取消</button>
                        <button type="submit">添加</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 编辑分类弹窗 -->
    <div id="editCategoryModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>编辑分类</h3>
                <span class="close" onclick="hideEditCategoryModal();">&times;</span>
            </div>
            <div class="modal-body">
                <form id="editCategoryForm">
                    <input type="hidden" id="editCategoryOriginalName" name="originalName">
                    <div class="form-group">
                        <label for="editCategoryName">分类名称：</label>
                        <input type="text" id="editCategoryName" name="categoryName" required>
                    </div>
                    <div class="form-group">
                        <label for="editCategoryIcon">分类图标：</label>
                        <div class="icon-input-container">
                            <input type="text" id="editCategoryIcon" name="categoryIcon" class="icon-input" placeholder="例如：📚" required>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" onclick="hideEditCategoryModal();">取消</button>
                        <button type="submit">保存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 添加网站弹窗 -->
    <div id="addWebsiteModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>添加网站</h3>
                <span class="close" onclick="hideAddWebsiteModal();">&times;</span>
            </div>
            <div class="modal-body">
                <form id="addWebsiteForm">
                    <div class="form-group">
                        <label for="websiteName">网站名称：</label>
                        <input type="text" id="websiteName" name="websiteName" required>
                    </div>
                    <div class="form-group">
                        <label for="websiteDescription">网站描述：</label>
                        <input type="text" id="websiteDescription" name="websiteDescription" placeholder="简要描述网站功能">
                    </div>
                    <div class="form-group">
                        <label for="websiteUrl">网站地址：</label>
                        <input type="url" id="websiteUrl" name="websiteUrl" placeholder="https://example.com" required>
                    </div>
                    <div class="form-group">
                        <label for="websiteIcon">网站图标：</label>
                        <div class="icon-input-container">
                            <input type="text" id="websiteIcon" name="websiteIcon" class="icon-input" placeholder="例如：🌐" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="websiteCategory">所属分类：</label>
                        <select id="websiteCategory" name="websiteCategory" required>
                            <option value="">请选择分类</option>
                            <!-- 分类选项将通过JavaScript动态生成 -->
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="websitePriceType">价格类型：</label>
                        <select id="websitePriceType" name="websitePriceType" required>
                            <option value="free">免费</option>
                            <option value="paid">付费</option>
                            <option value="trial">试用</option>
                            <option value="points">送积分</option>
                        </select>
                    </div>
                    <div class="form-actions">
                        <button type="button" onclick="hideAddWebsiteModal();">取消</button>
                        <button type="submit">添加</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Emoji图标选择器弹窗 -->
    <div id="iconPicker" class="icon-picker">
        <div class="icon-picker-content">
            <div class="icon-picker-header">
                <h3>选择图标</h3>
                <span class="close" onclick="hideIconPicker();">&times;</span>
            </div>
            
            <!-- 搜索框 -->
            <div class="icon-search-container">
                <input type="text" id="emojiSearch" class="icon-search-input" placeholder="搜索emoji..." autocomplete="off">
            </div>
            
            <!-- 分类标签 -->
            <div class="icon-categories-wrapper">
                
                <div id="emojiCategories" class="icon-categories">
                    <!-- 分类按钮将通过JavaScript动态生成 -->
                </div>
                
            </div>
            
            <!-- 图标网格 -->
            <div class="icon-grid-container">
                <div id="emojiGrid" class="icon-grid">
                    <!-- emoji图标将通过JavaScript动态加载 -->
                </div>
            </div>
        </div>
    </div>

    <!-- 页脚 -->
    <footer>
        <p>© 2024 网站导航 - 发现更多精彩网站</p>
        <p>快捷键：Ctrl/Cmd + K 快速搜索 | ESC 清空搜索</p>
    </footer>

    <!-- JavaScript -->
    <!-- IndexedDB存储系统 -->
    <link rel="stylesheet" href="/css/password-manager.css">
    <link rel="stylesheet" href="/css/data-manager.css">
    
    <script src="/js/CryptoUtils.js"></script>
    <script src="/js/NavigationDB.js"></script>
    <script src="/js/DataManager.js"></script>
    <script src="/js/PasswordManager.js"></script>
    <script src="/js/DataManagerUI.js"></script>
    <script src="/js/StorageIntegration.js"></script>
    <script src="/js/CategoryManager.js"></script>
    
    <!-- 模块化脚本 - 按依赖关系顺序加载 -->
    <script src="/js/CustomModal.js"></script>
    <script src="/js/EmojiIconPicker.js"></script>
    <script src="/js/NavigationApp.js"></script>
    <script src="/js/CategoryModal.js"></script>
    <script src="/js/WebsiteModal.js"></script>
    <script src="/js/AppInitializer.js"></script>
    
    <!-- 初始化存储集成系统 -->
    <script>
        // 等待页面加载完成后初始化存储系统
        document.addEventListener('DOMContentLoaded', async function() {
            try {
                // 初始化存储集成系统
                await initializeStorageIntegration();
                console.log('存储集成系统初始化成功');
            } catch (error) {
                console.error('存储集成系统初始化失败，使用传统模式:', error);
            }
        });
    </script>
    
    <!-- 结构化数据 -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "网站导航",
        "description": "精选优质网站导航，快速找到你需要的网站",
        "url": "<%= process.env.SITE_URL || 'http://localhost:3000' %>",
        "potentialAction": {
            "@type": "SearchAction",
            "target": "<%= process.env.SITE_URL || 'http://localhost:3000' %>/api/search?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
</body>
</html>