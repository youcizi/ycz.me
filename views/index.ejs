<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="精选优质AI网址导航，快速找到你需要的网站">
    <meta name="keywords" content="AI网址导航,导航网站,网址大全,常用网站">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🧭%3C/text%3E%3C/svg%3E">
    
    <!-- Vue3 和 Axios CDN - 优先加载 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script>
      // 仅使用 Koa 服务端注入的默认数据，避免重复来源
      window.__DEFAULT_DATA__ = <%- JSON.stringify(typeof defaultData !== 'undefined' ? defaultData : {}) %>;
      // 注入反馈接口地址（.env优先，其次默认地址）
      window.__FEEDBACK_URL__ = '<%= typeof feedbackUrl !== 'undefined' ? feedbackUrl : 'https://admin.ycz.me/api/site.index/feedback' %>';
    </script>
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="/css/category-manager.css">
    
    <!-- v-cloak 样式防止模板闪烁 -->
    <style>
        [v-cloak] {
            display: none !important;
        }
    </style>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
</head>
<body>
    <!-- Vue3 应用根元素 -->
    <div id="app" class="app-container" v-cloak>
        <!-- 左侧边栏 -->
        <aside class="sidebar" :class="{ collapsed: sidebarCollapsed }">
            <!-- 收缩/展开按钮 -->
            <button class="sidebar-toggle" type="button" aria-label="收缩/展开侧边栏" @click="toggleSidebar">
                <span class="toggle-icon">☰</span>
            </button>
            
            <!-- Logo区域 -->
            <div class="sidebar-logo">
                <div class="logo-icon">🧭</div>
                <div>
                    <div class="logo-text">AI网址导航</div>
                    <div class="logo-subtitle">打造专属于自己的网址导航</div>
                </div>
            </div>
            
            <!-- 分类导航 -->
            <nav class="sidebar-nav" role="navigation" aria-label="网站分类">
                <button 
                    class="nav-item" 
                    :class="{ active: !currentCategory }"
                    type="button"
                    @click="selectCategory(null)"
                >
                    <span class="nav-icon">📁</span>
                    <span class="nav-text">全部</span>
                </button>
                
                <!-- 层级分类显示 -->
                <template v-for="category in topLevelCategories" :key="category.id">
                    <!-- 一级分类 -->
                    <button 
                        class="nav-item parent-category" 
                        :class="{ active: currentCategory?.id === category.id }"
                        :data-category="category.name"
                        :data-category-id="category.id"
                        type="button"
                        @click="selectCategory(category)"
                    >
                        <!-- 展开/收缩图标 -->
                        <span 
                            v-if="hasSubCategories(category.id)" 
                            class="expand-icon"
                            @click.stop="toggleCategoryExpansion(category.id)"
                        >
                            {{ isCategoryExpanded(category.id) ? '▼' : '▶' }}
                        </span>
                        
                        <span class="nav-icon">{{ category.icon }}</span>
                        <span class="nav-text">{{ category.name }}</span>
                        <div class="nav-actions">
                            <span class="action-icon edit-category" @click.stop="showEditCategoryModal(category)">✏️</span>
                            <span class="action-icon delete-category" @click.stop="deleteCategory(category.id)">🗑️</span>
                        </div>
                    </button>
                    
                    <!-- 二级分类（子分类） -->
                    <template v-if="hasSubCategories(category.id) && isCategoryExpanded(category.id)">
                        <button 
                            v-for="subCategory in getSubCategories(category.id)" 
                            :key="subCategory.id"
                            class="nav-item sub-category" 
                            :class="{ active: currentCategory?.id === subCategory.id }"
                            :data-category="subCategory.name"
                            :data-category-id="subCategory.id"
                            type="button"
                            @click="selectCategory(subCategory)"
                        >
                            <span class="sub-category-indent"></span>
                            <span class="nav-icon">{{ subCategory.icon }}</span>
                            <span class="nav-text">{{ subCategory.name }}</span>
                            <div class="nav-actions">
                                <span class="action-icon edit-category" @click.stop="showEditCategoryModal(subCategory)">✏️</span>
                                <span class="action-icon delete-category" @click.stop="deleteCategory(subCategory.id)">🗑️</span>
                            </div>
                        </button>
                    </template>
                </template>
                
                <!-- 添加分类按钮 -->
                <button class="nav-item add-category-btn" type="button" @click="showAddCategoryModal">
                    <span class="nav-icon">➕</span>
                    <span class="nav-text">添加分类</span>
                </button>
            </nav>
        </aside>

        <!-- 右侧主内容区域 -->
        <main class="main-content">
            <!-- 顶部导航栏 -->
            <div class="top-bar">
                <!-- 左侧导航链接 -->
                <div class="top-nav-links">
                    <a href="/tools" class="nav-link">在线工具</a>
                    
                    <a href="/ai-chat" class="nav-link">AI聊天</a>
                    <a href="/emoji" class="nav-link">Emoji图标</a>                   
                    <a href="/data-manager" class="nav-link" id="data-manager-btn">数据管理</a>
					<a href="https://github.com/youcizi/ycz.me" target="_blank" class="nav-link">GitHub</a>
                </div>
                
                <!-- 右侧添加网站按钮 -->
                <div class="top-actions">
                    <button class="add-website-btn" type="button" aria-label="添加网站" @click="showAddWebsiteModal">
                        <span class="add-icon">➕</span>
                        <span class="add-text">添加网站</span>
                    </button>
                </div>
            </div>
            
            <!-- 搜索栏 -->
            <header class="content-header">
                <div class="search-container">
                    <!-- 搜索模式与引擎切换（置于搜索框上方） -->
                    <div class="search-toggle">
                        <button 
                            class="search-toggle-btn" 
                            :class="{ active: searchMode === 'site' }" 
                            @click="switchSearchMode('site')"
                            type="button"
                        >
                            站内
                        </button>
                        <button 
                            v-for="engine in searchEngines" 
                            :key="engine.id" 
                            class="search-toggle-btn" 
                            :class="{ active: searchMode === 'external' && selectedEngineId === engine.id }" 
                            @click="switchSearchMode('external'); selectExternalEngine(engine.id)"
                            type="button"
                            :title="engine.name"
                        >
                            {{ engine.name }}
                        </button>
                        <button 
                            class="search-toggle-btn engine-manager-btn" 
                            type="button"
                            @click="openEngineManager"
                            title="管理搜索引擎"
                        >
                            ⚙️
                        </button>
                    </div>

                    <!-- 站内搜索表单 -->
                    <div v-if="searchMode === 'site'" class="search-form">
                        <input 
                            type="text" 
                            id="siteSearchBox" 
                            class="search-box" 
                            v-model="siteSearchKeyword"
                            placeholder="站内搜索网站名称、描述或URL..." 
                            autocomplete="off"
                            @keyup.enter="performSearch"
                        >
                        <button class="search-btn" type="button" aria-label="站内搜索" @click="performSearch" title="搜索">
                            🔍
                        </button>
                    </div>

                    <!-- 外部搜索表单 -->
                    <div v-else class="search-form">
                        <input 
                            type="text" 
                            id="externalSearchBox" 
                            class="search-box" 
                            v-model="externalSearchKeyword"
                            placeholder="外部搜索关键词..." 
                            autocomplete="off"
                            @keyup.enter="performSearch"
                        >
                        <button class="search-btn" type="button" aria-label="外部搜索" @click="performSearch" title="外部搜索">
                            🌐
                        </button>
                    </div>
                </div>
            </header>

            <!-- 筛选栏 -->
            <div class="filter-bar">
                <div class="filter-container">
                    <span class="filter-label">筛选：</span>
					
                    <div class="filter-buttons">
                        <button class="filter-btn" :class="{ active: currentFilter === 'all' }" @click="setFilter('all')" type="button">全部</button>
                        <button class="filter-btn has-bg"
                                v-for="tag in filterTags" :key="tag.id"
                                :style="{ backgroundColor: currentFilter === tag.key? tag.backgroundColor:'#f8f8f8',color: currentFilter === tag.key? '#ffffff':'#6b7280' }"
                                :class="{ active: currentFilter === tag.key }"
                                @click="setFilter(tag.key)"
                                type="button">
                            {{ tag.name }}
                        </button>
                        <button class="filter-btn manage-btn" @click="openFilterManager" type="button">⚙️</button>
                    </div>
                </div>
            </div>

            <!-- 网站展示区域 -->
            <section class="websites-section" aria-label="网站列表">
                <!-- 网站卡片容器 -->
                <div v-if="isLoading" class="loading-state">
                    <div class="loading-spinner"></div>
                    <p>加载中...</p>
                </div>
                
                <div v-else-if="hasWebsites" class="websites-grid" id="websites-container">
                    <div 
                        v-for="website in filteredWebsites" 
                        :key="website.id"
                        class="website-card" 
                        :data-website-id="website.id"
                        @click="openWebsite(website.url)"
                    >
                        <!-- 筛选标签徽标：仅在存在匹配的标签名称时显示 -->
                        <div v-if="website.paymentType && getFilterName(website.paymentType)" 
                             class="payment-type-badge"
                             :style="{ backgroundColor: getFilterColor(website.paymentType) }">
                            {{ getFilterName(website.paymentType) }}
                        </div>
                        
                        <div class="website-icon">{{ website.icon }}</div>
                        <div class="website-info">
                            <h3 class="website-name">{{ website.title || website.name }}</h3>
                            <p class="website-description">{{ website.description }}</p>
                        </div>
                        
                        <div class="card-actions">
                            <button @click.stop="showEditWebsiteModal(website)" class="action-icon edit-icon">✏️</button>
                            <button @click.stop="deleteWebsite(website.id)" class="action-icon delete-icon">🗑️</button>
                        </div>
                    </div>
                </div>
                
                <div v-else class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p class="empty-text">暂无数据</p>
                </div>
            </section>
        </main>
        
        <!-- 添加分类模态框 -->
    <div class="modal-overlay" v-show="modals.addCategory" @click="closeCategoryModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>添加分类</h3>
                <button class="close-btn" @click="closeCategoryModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="categoryName">分类名称</label>
                    <input type="text" 
                           id="categoryName" 
                           v-model="categoryForm.name" 
                           placeholder="请输入分类名称">
                </div>
                <div class="form-group">
                    <label for="categoryParent">父级分类</label>
                    <select id="categoryParent" v-model="categoryForm.parentId">
                        <option value="">无（创建一级分类）</option>
                        <option v-for="category in availableParentCategories" 
                                :key="category.id" 
                                :value="category.id">
                            {{ category.name }}
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="categoryIcon">分类图标</label>
                    <div class="icon-input">
                        <input type="text" 
                               class="icon-preview-input" 
                               v-model="categoryForm.icon" 
                               placeholder="输入或选择图标"
                               maxlength="10">
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('category', categoryForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeCategoryModal">取消</button>
                <button class="btn btn-primary" @click="saveCategory">保存</button>
            </div>
        </div>
    </div>
    
    <!-- 编辑分类模态框 -->
    <div class="modal-overlay" v-show="modals.editCategory" @click="closeCategoryModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>编辑分类</h3>
                <button class="close-btn" @click="closeCategoryModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="editCategoryName">分类名称</label>
                    <input type="text" 
                           id="editCategoryName" 
                           v-model="categoryForm.name" 
                           placeholder="请输入分类名称">
                </div>
                <div class="form-group">
                    <label for="editCategoryParent">父级分类</label>
                    <select id="editCategoryParent" v-model="categoryForm.parentId">
                        <option value="">无（创建一级分类）</option>
                        <option v-for="category in availableParentCategories" 
                                :key="category.id" 
                                :value="category.id">
                            {{ category.name }}
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="editCategoryIcon">分类图标</label>
                    <div class="icon-input">
                        <input type="text" 
                               class="icon-preview-input" 
                               v-model="categoryForm.icon" 
                               placeholder="输入或选择图标"
                               maxlength="10">
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('category', categoryForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeCategoryModal">取消</button>
                <button class="btn btn-primary" @click="saveCategory">保存</button>
            </div>
        </div>
    </div>

    <!-- 搜索引擎管理模态框 -->
    <div class="modal-overlay" v-show="engineModal.show" @click="closeEngineManager">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>搜索引擎管理</h3>
                <button class="close-btn" @click="closeEngineManager">✕</button>
            </div>
            <div class="modal-body">
                <!-- 引擎列表 -->
                <div class="engine-list">
                    <div 
                        class="engine-item" 
                        v-for="engine in searchEngines" 
                        :key="engine.id"
                    >
                        <span class="engine-name" :title="engine.name">{{ engine.name }}</span>
                        <div class="engine-actions">
                            <button class="icon-btn" @click="startEditEngine(engine)" type="button" title="编辑" aria-label="编辑">✏️</button>
                            <button class="icon-btn" @click="deleteEngine(engine.id)" type="button" title="删除" aria-label="删除">🗑️</button>
                            <button class="icon-btn" @click="moveEngineUp(engine.id)" type="button" title="上移" aria-label="上移">↑</button>
                            <button class="icon-btn" @click="moveEngineDown(engine.id)" type="button" title="下移" aria-label="下移">↓</button>
                        </div>
                    </div>
                </div>

                

                <!-- 引擎表单（添加/编辑） -->
                <div class="form-group">
                    <label>引擎名称</label>
                    <input type="text" v-model="engineForm.name" placeholder="如：Google、百度">
                </div>
                <div class="form-group">
                    <label>搜索模板</label>
                    <input type="text" v-model="engineForm.template" placeholder="如：https://www.google.com/search?q={q}"> 
                    <small>使用 {q} 作为关键词占位符</small>
                </div>                
                <div class="form-group">
                    <label>排序</label>
                    <input type="number" v-model="engineForm.order" min="0">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="startAddEngine" type="button">新增</button>
                <button class="btn btn-primary" @click="saveEngine" type="button">保存</button>
            </div>
        </div>
    </div>

    <!-- 添加网站模态框 -->
    <div class="modal-overlay" v-show="modals.addWebsite" @click="closeWebsiteModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>{{ editingWebsite ? '编辑网站' : '添加网站' }}</h3>
                <button class="close-btn" @click="closeWebsiteModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="websiteName">网站名称</label>
                    <input type="text" 
                           id="websiteName" 
                           v-model="websiteForm.title" 
                           placeholder="请输入网站名称">
                </div>
                <div class="form-group">
                    <label for="websiteUrl">网站地址</label>
                    <input type="url" 
                           id="websiteUrl" 
                           v-model="websiteForm.url" 
                           placeholder="请输入网站地址">
                </div>
                <div class="form-group">
                    <label for="websiteDescription">网站描述</label>
                    <textarea id="websiteDescription" 
                              v-model="websiteForm.description" 
                              placeholder="请输入网站描述"></textarea>
                </div>
                <div class="form-group">
                    <label for="websiteCategory">所属分类</label>
                    <select id="websiteCategory" v-model="websiteForm.categoryId">
                        <option value="">请选择分类</option>
                        <option v-for="category in categories" 
                                :key="category.id" 
                                :value="category.id">
                            {{ category.name }}
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="websiteIcon">网站图标</label>
                    <div class="icon-input">
                        <input type="text" 
                               class="icon-preview-input" 
                               v-model="websiteForm.icon" 
                               placeholder="输入或选择图标"
                               maxlength="10">
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('website', websiteForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="websitePaymentType">标签</label>
                    <select id="websitePaymentType" v-model="websiteForm.paymentType">
                        <option value="">请选择标签</option>
                        <option v-for="tag in filterTags" :key="tag.id" :value="tag.key">{{ tag.name }}</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeWebsiteModal">取消</button>
                <button class="btn btn-primary" @click="saveWebsite">保存</button>
            </div>
        </div>
    </div>

    <!-- 筛选标签管理模态框（移动至 #app 容器内） -->
    <div class="modal-overlay" v-show="modals.filterManager" @click="closeFilterManager">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>管理筛选标签</h3>
                <button class="close-btn" @click="closeFilterManager">✕</button>
            </div>
            <div class="modal-body">
                <div class="filter-list">
                    <div class="filter-item" v-for="tag in filterTags" :key="tag.id">
                        <span class="filter-preview" :style="{ backgroundColor: tag.backgroundColor }">{{ tag.name }} ({{ tag.key }})</span>
                        <div class="filter-actions">
                            <button class="icon-btn" @click="startEditFilter(tag)" type="button" title="编辑" aria-label="编辑">✏️</button>
                            <button class="icon-btn" @click="deleteFilter(tag.id)" type="button" title="删除" aria-label="删除">🗑️</button>
                            <button class="icon-btn" @click="moveFilterUp(tag.id)" type="button" title="上移" aria-label="上移">↑</button>
                            <button class="icon-btn" @click="moveFilterDown(tag.id)" type="button" title="下移" aria-label="下移">↓</button>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="filterName">名称</label>
                    <input id="filterName" type="text" v-model="filterForm.name" placeholder="请输入标签名称">
                </div>
                <div class="form-group">
                    <label for="filterKey">Key</label>
                    <input id="filterKey" type="text" v-model="filterForm.key" placeholder="用于筛选的唯一键值">
                </div>
                <div class="form-group">
                    <label for="filterColor">背景色</label>
                    <input id="filterColor" type="color" v-model="filterForm.backgroundColor" :style="{borderColor:filterForm.backgroundColor, backgroundColor: filterForm.backgroundColor }">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="startAddFilter" type="button">新增</button>
                <button class="btn btn-primary" @click="saveFilter" type="button">保存</button>
            </div>
        </div>
    </div>
    


    <!-- 图标选择器模态框 -->
    <div class="modal-overlay" v-show="modals.iconSelector" @click="closeIconSelector">
        <div class="modal-content icon-picker-modal" @click.stop>
            <div class="modal-header">
                <h3>选择图标</h3>
                <button class="close-btn" @click="closeIconSelector">✕</button>
            </div>
            <div class="modal-body">
                <div class="icon-categories">
                    <button v-for="category in iconCategories" 
                            :key="category.name"
                            :class="['category-btn', { active: iconSelector.selectedCategory === category.name }]"
                            @click="selectIconCategory(category.name)">
                        {{ category.label }}
                    </button>
                </div>
                <div class="icon-grid">
                    <button v-for="icon in currentIcons" 
                            :key="icon"
                            :class="['icon-btn', { selected: iconSelector.selectedIcon === icon }]"
                            @click="selectIcon(icon)">
                        {{ icon }}
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeIconSelector">取消</button>
                <button class="btn btn-primary" @click="confirmIconSelection">确认</button>
            </div>
        </div>
    </div>
    </div>

    <!-- 页脚 -->
    <footer>
        <p>©copyright  2024 <a href="https://ycz.me"">AI网址导航</a> - 发现更多精彩网站 </p>
    </footer>


    
    <link rel="stylesheet" href="/css/data-manager.css">
    
    <script src="/js/CustomModal.js"></script>
    <script src="/js/EmojiIconPicker.js"></script>
    
    <!-- 服务模块 -->
    <script type="module" src="/js/services/IndexedDBService.js"></script>
    <script type="module" src="/js/services/DataSyncService.js"></script>
    
    <!-- 管理器模块 -->
    <script type="module" src="/js/modules/CategoryManager.js"></script>
    <script type="module" src="/js/modules/WebsiteManager.js"></script>
    <script type="module" src="/js/modules/UIManager.js"></script>
    
    <!-- 状态管理模块 -->
