<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="精选优质网站导航，快速找到你需要的网站">
    <meta name="keywords" content="网站导航,导航网站,网址大全,常用网站">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🧭%3C/text%3E%3C/svg%3E">
    
    <!-- Vue3 和 Axios CDN - 优先加载 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/category-manager.css">
    
    <!-- v-cloak 样式防止模板闪烁 -->
    <style>
        [v-cloak] {
            display: none !important;
        }
    </style>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
</head>
<body>
    <!-- Vue3 应用根元素 -->
    <div id="app" class="app-container" v-cloak>
        <!-- 左侧边栏 -->
        <aside class="sidebar">
            <!-- 收缩/展开按钮 -->
            <button class="sidebar-toggle" type="button" aria-label="收缩/展开侧边栏">
                <span class="toggle-icon">☰</span>
            </button>
            
            <!-- Logo区域 -->
            <div class="sidebar-logo">
                <div class="logo-icon">🧭</div>
                <div>
                    <div class="logo-text">网站导航</div>
                    <div class="logo-subtitle">快速发现优质网站资源</div>
                </div>
            </div>
            
            <!-- 分类导航 -->
            <nav class="sidebar-nav" role="navigation" aria-label="网站分类">
                <button 
                    class="nav-item" 
                    :class="{ active: !currentCategory }"
                    type="button"
                    @click="selectCategory(null)"
                >
                    <span class="nav-icon">📁</span>
                    <span class="nav-text">全部</span>
                </button>
                <button 
                    v-for="category in categories" 
                    :key="category.id"
                    class="nav-item" 
                    :class="{ active: currentCategory?.id === category.id }"
                    :data-category="category.name"
                    :data-category-id="category.id"
                    type="button"
                    @click="selectCategory(category)"
                >
                    <span class="nav-icon">{{ category.icon }}</span>
                    <span class="nav-text">{{ category.name }}</span>
                    <div class="nav-actions">
                        <span class="action-icon edit-category" @click.stop="showEditCategoryModal(category)">✏️</span>
                        <span class="action-icon delete-category" @click.stop="deleteCategory(category.id)">🗑️</span>
                    </div>
                </button>
                <!-- 添加分类按钮 -->
                <button class="nav-item add-category-btn" type="button" @click="showAddCategoryModal">
                    <span class="nav-icon">➕</span>
                    <span class="nav-text">添加分类</span>
                </button>
            </nav>
        </aside>

        <!-- 右侧主内容区域 -->
        <main class="main-content">
            <!-- 顶部导航栏 -->
            <div class="top-bar">
                <!-- 左侧导航链接 -->
                <div class="top-nav-links">
                    <a href="#" class="nav-link">关于我们</a>
                    <a href="#" class="nav-link">动态</a>
                    <a href="#" class="nav-link">网址提交</a>
                </div>
                
                <!-- 右侧添加网站按钮 -->
                <div class="top-actions">
                    <button class="add-website-btn" type="button" aria-label="添加网站" @click="showAddWebsiteModal">
                        <span class="add-icon">➕</span>
                        <span class="add-text">添加网站</span>
                    </button>
                </div>
            </div>
            
            <!-- 搜索栏 -->
            <header class="content-header">
                <div class="search-container">
                    <input 
                        type="text" 
                        id="searchBox" 
                        class="search-box" 
                        v-model="searchKeyword"
                        placeholder="搜索网站名称或描述..." 
                        autocomplete="off"
                    >
                    <button id="searchBtn" class="search-btn" type="button" aria-label="搜索">
                        🔍
                    </button>
                </div>
            </header>

            <!-- 筛选栏 -->
            <div class="filter-bar">
                <div class="filter-container">
                    <span class="filter-label">筛选：</span>
                    <div class="filter-buttons">
                        <button class="filter-btn" :class="{ active: currentFilter === 'all' }" @click="setFilter('all')" type="button">全部</button>
                        <button class="filter-btn" :class="{ active: currentFilter === 'free' }" @click="setFilter('free')" type="button">免费</button>
                        <button class="filter-btn" :class="{ active: currentFilter === 'paid' }" @click="setFilter('paid')" type="button">付费</button>
                        <button class="filter-btn" :class="{ active: currentFilter === 'trial' }" @click="setFilter('trial')" type="button">试用</button>
                        <button class="filter-btn" :class="{ active: currentFilter === 'points' }" @click="setFilter('points')" type="button">送积分</button>
                    </div>
                </div>
            </div>

            <!-- 网站展示区域 -->
            <section class="websites-section" aria-label="网站列表">
                <!-- 网站卡片容器 -->
                <div v-if="isLoading" class="loading-state">
                    <div class="loading-spinner"></div>
                    <p>加载中...</p>
                </div>
                
                <div v-else-if="hasWebsites" class="websites-grid" id="websites-container">
                    <div 
                        v-for="website in filteredWebsites" 
                        :key="website.id"
                        class="website-card" 
                        :data-website-id="website.id"
                        @click="openWebsite(website.url)"
                    >
                        <!-- 付费类型标识 -->
                        <div v-if="website.paymentType" 
                             class="payment-type-badge" 
                             :class="getPaymentTypeClass(website.paymentType)">
                            {{ getPaymentTypeLabel(website.paymentType) }}
                        </div>
                        
                        <div class="website-icon">{{ website.icon }}</div>
                        <div class="website-info">
                            <h3 class="website-name">{{ website.title || website.name }}</h3>
                            <p class="website-description">{{ website.description }}</p>
                        </div>
                        
                        <div class="card-actions">
                            <button @click.stop="showEditWebsiteModal(website)" class="action-icon edit-icon">✏️</button>
                            <button @click.stop="deleteWebsite(website.id)" class="action-icon delete-icon">🗑️</button>
                        </div>
                    </div>
                </div>
                
                <div v-else class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p class="empty-text">暂无网站</p>
                </div>
            </section>
        </main>
        
        <!-- 添加分类模态框 -->
    <div class="modal-overlay" v-show="modals.addCategory" @click="closeCategoryModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>添加分类</h3>
                <button class="close-btn" @click="closeCategoryModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="categoryName">分类名称</label>
                    <input type="text" 
                           id="categoryName" 
                           v-model="categoryForm.name" 
                           placeholder="请输入分类名称">
                </div>
                <div class="form-group">
                    <label for="categoryIcon">分类图标</label>
                    <div class="icon-input">
                        <span class="icon-preview">{{ categoryForm.icon }}</span>
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('category', categoryForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeCategoryModal">取消</button>
                <button class="btn btn-primary" @click="saveCategory">保存</button>
            </div>
        </div>
    </div>
    
    <!-- 编辑分类模态框 -->
    <div class="modal-overlay" v-show="modals.editCategory" @click="closeCategoryModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>编辑分类</h3>
                <button class="close-btn" @click="closeCategoryModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="editCategoryName">分类名称</label>
                    <input type="text" 
                           id="editCategoryName" 
                           v-model="categoryForm.name" 
                           placeholder="请输入分类名称">
                </div>
                <div class="form-group">
                    <label for="editCategoryIcon">分类图标</label>
                    <div class="icon-input">
                        <span class="icon-preview">{{ categoryForm.icon }}</span>
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('category', categoryForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeCategoryModal">取消</button>
                <button class="btn btn-primary" @click="saveCategory">保存</button>
            </div>
        </div>
    </div>

    <!-- 添加网站模态框 -->
    <div class="modal-overlay" v-show="modals.addWebsite" @click="closeWebsiteModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>添加网站</h3>
                <button class="close-btn" @click="closeWebsiteModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="websiteName">网站名称</label>
                    <input type="text" 
                           id="websiteName" 
                           v-model="websiteForm.title" 
                           placeholder="请输入网站名称">
                </div>
                <div class="form-group">
                    <label for="websiteUrl">网站地址</label>
                    <input type="url" 
                           id="websiteUrl" 
                           v-model="websiteForm.url" 
                           placeholder="请输入网站地址">
                </div>
                <div class="form-group">
                    <label for="websiteDescription">网站描述</label>
                    <textarea id="websiteDescription" 
                              v-model="websiteForm.description" 
                              placeholder="请输入网站描述"></textarea>
                </div>
                <div class="form-group">
                    <label for="websiteCategory">所属分类</label>
                    <select id="websiteCategory" v-model="websiteForm.categoryId">
                        <option value="">请选择分类</option>
                        <option v-for="category in categories" 
                                :key="category.id" 
                                :value="category.id">
                            {{ category.name }}
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="websiteIcon">网站图标</label>
                    <div class="icon-input">
                        <span class="icon-preview">{{ websiteForm.icon }}</span>
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('website', websiteForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="websitePaymentType">付费类型</label>
                    <select id="websitePaymentType" v-model="websiteForm.paymentType">
                        <option value="">请选择付费类型</option>
                        <option value="free">免费</option>
                        <option value="paid">付费</option>
                        <option value="trial">试用</option>
                        <option value="points">送积分</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeWebsiteModal">取消</button>
                <button class="btn btn-primary" @click="saveWebsite">保存</button>
            </div>
        </div>
    </div>
    
    <!-- 编辑网站模态框 -->
    <div class="modal-overlay" v-show="modals.editWebsite" @click="closeWebsiteModal">
        <div class="modal-content" @click.stop>
            <div class="modal-header">
                <h3>编辑网站</h3>
                <button class="close-btn" @click="closeWebsiteModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="editWebsiteName">网站名称</label>
                    <input type="text" 
                           id="editWebsiteName" 
                           v-model="websiteForm.title" 
                           placeholder="请输入网站名称">
                </div>
                <div class="form-group">
                    <label for="editWebsiteUrl">网站地址</label>
                    <input type="url" 
                           id="editWebsiteUrl" 
                           v-model="websiteForm.url" 
                           placeholder="请输入网站地址">
                </div>
                <div class="form-group">
                    <label for="editWebsiteDescription">网站描述</label>
                    <textarea id="editWebsiteDescription" 
                              v-model="websiteForm.description" 
                              placeholder="请输入网站描述"></textarea>
                </div>
                <div class="form-group">
                    <label for="editWebsiteCategory">所属分类</label>
                    <select id="editWebsiteCategory" v-model="websiteForm.categoryId">
                        <option value="">请选择分类</option>
                        <option v-for="category in categories" 
                                :key="category.id" 
                                :value="category.id">
                            {{ category.name }}
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="editWebsiteIcon">网站图标</label>
                    <div class="icon-input">
                        <span class="icon-preview">{{ websiteForm.icon }}</span>
                        <button type="button" 
                                class="icon-picker-btn" 
                                @click="showIconSelector('website', websiteForm.icon)">
                            选择图标
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="editWebsitePaymentType">付费类型</label>
                    <select id="editWebsitePaymentType" v-model="websiteForm.paymentType">
                        <option value="">请选择付费类型</option>
                        <option value="free">免费</option>
                        <option value="paid">付费</option>
                        <option value="trial">试用</option>
                        <option value="points">送积分</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeWebsiteModal">取消</button>
                <button class="btn btn-primary" @click="saveWebsite">保存</button>
            </div>
        </div>
    </div>

    <!-- 图标选择器模态框 -->
    <div class="modal-overlay" v-show="modals.iconSelector" @click="closeIconSelector">
        <div class="modal-content icon-picker-modal" @click.stop>
            <div class="modal-header">
                <h3>选择图标</h3>
                <button class="close-btn" @click="closeIconSelector">✕</button>
            </div>
            <div class="modal-body">
                <div class="icon-categories">
                    <button v-for="category in iconCategories" 
                            :key="category.name"
                            :class="['category-btn', { active: iconSelector.selectedCategory === category.name }]"
                            @click="selectIconCategory(category.name)">
                        {{ category.label }}
                    </button>
                </div>
                <div class="icon-grid">
                    <button v-for="icon in currentIcons" 
                            :key="icon"
                            :class="['icon-btn', { selected: iconSelector.selectedIcon === icon }]"
                            @click="selectIcon(icon)">
                        {{ icon }}
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeIconSelector">取消</button>
                <button class="btn btn-primary" @click="confirmIconSelection">确认</button>
            </div>
        </div>
    </div>
    </div>

    <!-- 页脚 -->
    <footer>
        <p>© 2024 网站导航 - 发现更多精彩网站</p>
        <p>快捷键：Ctrl/Cmd + K 快速搜索 | ESC 清空搜索</p>
    </footer>


    
    <!-- 保留必要的工具类 -->
    <link rel="stylesheet" href="/css/password-manager.css">
    <link rel="stylesheet" href="/css/data-manager.css">
    
    <script src="/js/CryptoUtils.js"></script>
    
    <!-- 通用模块 -->
    <script src="/js/CustomModal.js"></script>
    <script src="/js/EmojiIconPicker.js"></script>
    
    <!-- 模块化脚本 -->
    <script type="module" src="/js/services/IndexedDBService.js"></script>
    <script type="module" src="/js/services/DataSyncService.js"></script>
    <script type="module" src="/js/modules/CategoryManager.js"></script>
    <script type="module" src="/js/modules/WebsiteManager.js"></script>
    <script type="module" src="/js/modules/UIManager.js"></script>
    <script type="module" src="/js/vue-app.js"></script>
    
    <!-- Vue3 应用初始化 -->
    <script>
        // Vue3 应用将在 vue-app.js 中初始化
    </script>
    
    <!-- 结构化数据 -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "网站导航",
        "description": "精选优质网站导航，快速找到你需要的网站",
        "url": "<%= process.env.SITE_URL || 'http://localhost:3000' %>",
        "potentialAction": {
            "@type": "SearchAction",
            "target": "<%= process.env.SITE_URL || 'http://localhost:3000' %>/api/search?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
</body>
</html>