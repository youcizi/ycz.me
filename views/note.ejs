<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="在线笔记，支持本地IndexedDB存储、导入导出">
  <meta name="keywords" content="在线笔记, 笔记本, IndexedDB, 本地存储">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/note.css">
  <!-- Toast UI Editor -->
  <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
  <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
  <!-- Google Tag Manager -->
	<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
	new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
	j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
	'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
	})(window,document,'script','dataLayer','GTM-556X699R');</script>
<!-- End Google Tag Manager -->
</head>
<body>
	<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-556X699R"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
  <div id="app" class="app-container note-page" :class="{'note-collapsed': isSidebarCollapsed}" v-cloak>
    <main class="main-content">
      <!-- 顶部导航栏，与首页风格一致 -->
      <div class="top-bar">
        <div class="top-nav-links">
          <a href="/" class="nav-link">返回首页</a>
          <span class="nav-link active">在线笔记</span>
		  <a href="/note-manager" class="nav-link">笔记管理</a>
          <a href="/ai-chat" class="nav-link">AI聊天</a>
          <a href="/emoji" class="nav-link">Emoji图标</a>
          <a href="/data-manager" class="nav-link">数据管理</a>
        </div>
        <div class="top-actions" style="display:flex; gap:8px;">
          <button class="btn btn-primary" @click="addCategory">添加分类</button>
          <button class="btn btn-secondary" @click="addNote">新建笔记</button>
          <label class="tool-btn ghost" style="display:inline-flex; align-items:center; gap:6px;">
            导入
            <input type="file" accept="application/json" style="display:none;" @change="importNotes($event)">
          </label>
          <button class="btn btn-secondary" @click="exportNotes">导出</button>
        </div>
      </div>

      <!-- 两列布局：左侧分类 + 右侧笔记列表与编辑器 -->
      <section class="note-main" aria-label="在线笔记">
        <!-- 左：分类列表 -->
        <aside class="note-sidebar">
          <div class="note-title">
            分类
            <button class="note-collapse-btn" @click="toggleSidebar" :title="isSidebarCollapsed ? '展开' : '收缩'">
              {{ isSidebarCollapsed ? '›' : '‹' }}
            </button>
          </div>
          <ul class="note-cat-list">
            <li :class="['note-cat-item', { active: !currentCategoryId }]" @click="selectCategory(null)">
              <span class="cat-icon">📁</span>
              <span class="cat-name">全部</span>
            </li>
            <li v-for="cat in categories" :key="cat.id" :class="['note-cat-item', { active: currentCategoryId === cat.id }]" @click="selectCategory(cat.id)">
              <span class="cat-icon">{{ cat.icon || '📁' }}</span>
              <span class="cat-name">{{ cat.name }}</span>
              <div class="cat-actions">
                <button class="action-btn" title="重命名" @click.stop="renameCategory(cat.id)">✏️</button>
                <button class="action-btn danger" title="删除" @click.stop="deleteCategory(cat.id)">🗑️</button>
              </div>
            </li>
          </ul>
        </aside>

        <!-- 右：笔记列表 + 编辑器 -->
        <div class="note-content">
          <div class="content-header-row">
            <h2 class="content-title">{{ currentCategoryLabel }}</h2>
            <div class="note-tools">
              <input class="tool-input" type="text" v-model="searchQuery" placeholder="搜索标题或内容">
            </div>
          </div>

          <div class="note-layout-two-cols">
            <!-- 笔记列表 -->
            <aside class="note-list">
              <ul class="tools-list">
              <ul class="tools-list">
                <li v-for="n in filteredNotes" :key="n.id" :class="['tools-item', { active: currentNoteId === n.id }]" @click="selectNote(n.id)">
                  <span class="tool-icon">📝</span>
                  <span class="tool-name">{{ n.title || '未命名笔记' }}</span>
                  <button class="item-ellipsis" @click.stop="noteMenuId === n.id ? noteMenuId=null : noteMenuId=n.id">⋯</button>
                  <div class="item-menu" v-if="noteMenuId === n.id">
                    <button class="menu-close" @click.stop="noteMenuId=null">×</button>
                    <button class="menu-item" @click.stop="renameNote(n.id)">重命名</button>
                    <button class="menu-item" @click.stop="changeNoteCategory(n.id)">修改分类</button>
                    <button class="menu-item danger" @click.stop="deleteNote(n.id)">删除</button>
                  </div>
                </li>
              </ul>
            </aside>

            <!-- 编辑器区域 -->
            <div class="note-editor">
              <div class="tool-row column">
                <label class="tool-label">标题</label>
                <input class="tool-input" type="text" v-model="noteTitle" placeholder="请输入笔记标题">
              </div>
              <div class="tool-row column" v-show="isEditing">
                <label class="tool-label">内容</label>
                <div id="md-editor"></div>
              </div>
              <div class="tool-row column" v-show="!isEditing">
                <label class="tool-label">内容</label>
                <div class="md-view" style="max-height: 60vh; overflow: auto; white-space: pre-wrap; border: 1px solid #eee; border-radius: 6px; padding: 12px; min-height: 180px; background: #fafafa;">
                  {{ noteContent }}
                </div>
              </div>
              <div class="tool-actions">
                <button class="tool-btn primary" v-show="isEditing" @click="saveNote">保存</button>
                <button class="tool-btn primary" v-show="!isEditing" @click="editNote">编辑</button>
                <button class="tool-btn secondary" @click="copyNoteContent">复制内容</button>
                <button class="tool-btn ghost" v-show="isEditing" @click="clearEditor">清空</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script src="/js/vue.global.js"></script>
  <script src="/js/CustomModal.js"></script>
  <script type="module" src="/js/note-app.js"></script>
</body>
</html>